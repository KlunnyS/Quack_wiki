QUACK_ENV=production
QUACK_SECRET_KEY=replace-with-a-long-random-secret
# Railway PostgreSQL automatically exposes DATABASE_URL.
# Only set QUACK_DATABASE_URI if you want to override DATABASE_URL.
# QUACK_DATABASE_URI=postgresql://user:password@host:port/database
QUACK_SESSION_COOKIE_SECURE=true
# Set this to true only when you intentionally want the first admin created.
QUACK_SEED_INITIAL_USERS=false
# Use MainAdmin if you want the built-in owner protections to apply.
QUACK_ADMIN_USERNAME=MainAdmin
QUACK_ADMIN_EMAIL=admin@example.com
QUACK_ADMIN_PASSWORD=replace-with-a-strong-password
